; Valluvar's Pond: a 3D fishing game built on the Thirukkural.
config_version=5

[application]

config/name="Valluvar's Pond"
config/description="Thiruvalluvar fishes for the missing words of his Kurals."
run/main_scene="res://main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.106, 0.071, 0.047, 1)
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.62, 0.8, 0.86, 1)

[audio]

general/text_to_speech=true
